IDI_ICON1		ICON		DISCARDABLE	"softprojector.ico"

#include <winver.h>

// Version details shown by Windows (Task Manager, file properties, app lists).
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "CGF Projector"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "CGFProjector"
            VALUE "LegalCopyright",   "GPL v3. Based on SoftProjector, Copyright (C) Vladislav Kobzar and contributors"
            VALUE "OriginalFilename", "CGFProjector.exe"
            VALUE "ProductName",      "CGF Projector"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
